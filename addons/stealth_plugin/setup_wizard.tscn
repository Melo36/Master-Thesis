[node name="WalkingNoiseLabel" type="Label" parent="VBoxContainer/MovementNoise/MarginContainer/GridContainer" unique_id=1473947919]
layout_mode = 2
tooltip_text = "Controls the noise produced while walking. The value is measured in decibels (dB) relative to the stealth system's reference level. Higher values produce more noise and make the player easier to detect.

Lower dB → quieter → harder to detect
Higher dB → louder → easier to detect

 -80 dB   -20 dB   -10 dB          0 dB          +10 dB    +20 dB    +80 dB
 Quieter ──────────────── Reference ────────────────→ Louder"
mouse_filter = 0
text = "Walking Noise"

[node name="walking_noise" type="SpinBox" parent="VBoxContainer/MovementNoise/MarginContainer/GridContainer" unique_id=335852804 groups=["PlayerInput"]]
layout_mode = 2
min_value = -80.0
max_value = 80.0
suffix = "dB"

