[node name="Label" type="Label" parent="VBoxContainer/Patrol Route/MarginContainer" unique_id=1285945763]
layout_mode = 2
text = "To specify the patrol route of the guard follow these steps:
- Click \"Create Guard\" once you are finished with the configuration
- Find the \"Guard\" node in the scene tree
- Expand the \"Guard\" Node
- Click on \"Path3D\"
- Click \"Create Curve\" in the toolbar above the game screen
- Select the option \"Add Point\" and place path markers in the scene
- Tip: Use orthogonal view (7 on the keyboard) to prevent projection issues"
autowrap_mode = 3

